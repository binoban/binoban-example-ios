# macOS
.DS_Store

# Xcode user-specific
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# Build output
build/
DerivedData/

# Swift Package Manager — Xcode re-resolves packages on open
.swiftpm/

# Local SDK binary (the SDK is pulled via Swift Package Manager, not committed)
binoban.xcframework/
*.xcframework/

# Firebase credential — never commit. Each developer drops their own
# GoogleService-Info.plist into ios/ to enable push notifications.
GoogleService-Info.plist
